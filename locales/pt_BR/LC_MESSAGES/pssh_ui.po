msgid ""
"Verify ArubaOS-CX syntax and confirm the switch is in the required "
"configuration context."
msgstr ""
"Verifique a sintaxe do ArubaOS-CX e confirme se o switch está no contexto"
" de configuração correto."

#: pssh_ui/parser.py:46
msgid "Ambiguous command"
msgstr "Comando ambíguo"

#: pssh_ui/parser.py:47
msgid "Spell out the full command keyword so it is unambiguous."
msgstr "Escreva o comando por extenso para evitar ambiguidade."

#: pssh_ui/parser.py:50
msgid "Incomplete command"
msgstr "Comando incompleto"

#: pssh_ui/parser.py:51
msgid "Provide all required command parameters on the same line."
